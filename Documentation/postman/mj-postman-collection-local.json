{
  "info": {
    "name": "MJ Auth API ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userFirstName\": \"Jean\",\n  \"userLastName\": \"Dupont\",\n  \"userPhone\": \"0612345678\",\n  \"userEmail\": \"jean.dupont@test.com\",\n  \"userPassword\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Réponse register:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', () => pm.expect(json.userToken).to.be.a('string'));",
                  "if (json.userToken) { pm.environment.set('token', json.userToken); } else { pm.environment.unset('token'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"jean.dupont@test.com\",\n  \"userPassword\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Réponse login:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', () => pm.expect(json.userToken).to.be.a('string'));",
                  "pm.test('Email correct', () => pm.expect(json.userEmail).to.eql('jean.dupont@test.com'));",
                  "if (json.userToken) { pm.environment.set('token', json.userToken); } else { pm.environment.unset('token'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Mauvais mot de passe",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"jean.dupont@test.com\",\n  \"userPassword\": \"mauvaismdp\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Email inexistant",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"inconnu@test.com\",\n  \"userPassword\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Email déjà utilisé",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userFirstName\": \"Jean\",\n  \"userLastName\": \"Dupont\",\n  \"userPhone\": \"0612345678\",\n  \"userEmail\": \"jean.dupont@test.com\",\n  \"userPassword\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who I Am - Avec token",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{baseUrl}}/api/auth/whoiam"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Email présent', () => pm.expect(json.userEmail).to.be.a('string'));",
                  "pm.test('Prénom présent', () => pm.expect(json.userFirstName).to.be.a('string'));",
                  "pm.test('Nom présent', () => pm.expect(json.userLastName).to.be.a('string'));",
                  "pm.test('Pas de token dans la réponse', () => pm.expect(json.userToken).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who I Am - Sans token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/whoiam"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 ou 403', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Route protégée - Avec token",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{baseUrl}}/api/test/protected"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Non 401/403', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Route protégée - Sans token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/test/protected"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 ou 403', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
