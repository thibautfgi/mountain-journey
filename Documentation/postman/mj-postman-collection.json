{
  "info": {
    "name": "MJ Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\",\n  \"phone\": \"0612345678\",\n  \"email\": \"jean.dupont@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.dupont@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.test('Email correct', () => pm.expect(json.email).to.eql('jean.dupont@test.com'));",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Mauvais mot de passe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.dupont@test.com\",\n  \"password\": \"mauvaismdp\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Email inexistant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"inconnu@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Email déjà utilisé",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\",\n  \"phone\": \"0612345678\",\n  \"email\": \"jean.dupont@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 500]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Route protégée - Avec token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/test/protected"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Non 401/403', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Route protégée - Sans token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/test/protected"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 ou 403', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}